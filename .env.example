# =====================================================================
# Heritage Storytelling Agent - Environment Configuration
# =====================================================================

# Sarvam AI API Key (Required for STT, Translation, and TTS)
# Obtain from https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# LLM Provider Keys (Configure at least one for story generation)
# OpenAI API Key (for GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (alternative LLM provider)
GEMINI_API_KEY=your_gemini_api_key_here
